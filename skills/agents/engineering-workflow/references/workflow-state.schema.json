{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrayawongsaita.github.io/skills/engineering-workflow-state-v2.schema.json",
  "title": "Engineering Workflow State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowVersion",
    "id",
    "parentWorkflowId",
    "requestFingerprint",
    "workflowType",
    "incidentSubtype",
    "scope",
    "risk",
    "uncertainty",
    "changeCharacteristics",
    "stage",
    "stageMode",
    "status",
    "currentWorkItem",
    "artifactRefs",
    "completedStages",
    "baseGitRef",
    "lastVerifiedGitRef",
    "worktreeFingerprint",
    "verificationCommands",
    "gateCycles",
    "gateBudgets",
    "gateBlockers",
    "designScrutinizeCycles",
    "systemScrutinizeCycles",
    "scrutinizeHistory",
    "dependencies",
    "dependencyStatus",
    "blockedDependency",
    "pendingInstallationPermission",
    "childWorkflowIds",
    "mitigationOutstanding",
    "transitionHistory",
    "blocker",
    "updatedAt",
    "revision"
  ],
  "properties": {
    "workflowVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "parentWorkflowId": {"type": ["string", "null"]},
    "requestFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workflowType": {"enum": ["FEATURE", "BUG", "LARGE_PROJECT", null]},
    "incidentSubtype": {"enum": ["INCIDENT", null]},
    "scope": {"type": ["string", "null"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]},
    "uncertainty": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]},
    "changeCharacteristics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stage": {"enum": ["IDLE", "CLASSIFYING", "DISCOVERY", "EXPLORATION", "WAYFINDING", "SPECIFICATION", "DESIGN_REVIEW", "PLANNING", "DIAGNOSIS", "IMPLEMENTATION", "CODE_REVIEW", "SYSTEM_REVIEW", "POST_MORTEM", "COMPLETE", "BLOCKED"]},
    "stageMode": {"enum": ["REGRESSION_TEST", "FIX", "REVIEW_FIX", "EMERGENCY_MITIGATION", "BOUND_FEATURES", "RESEARCH", "PROTOTYPE", null]},
    "status": {"enum": ["IN_PROGRESS", "BLOCKED", "COMPLETE"]},
    "currentWorkItem": {"type": ["string", "null"]},
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "fingerprint", "producerStage", "gitRef"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "producerStage": {"type": "string"},
          "gitRef": {"type": ["string", "null"]}
        }
      }
    },
    "completedStages": {"type": "array", "items": {"type": "string"}},
    "baseGitRef": {"type": ["string", "null"]},
    "lastVerifiedGitRef": {"type": ["string", "null"]},
    "worktreeFingerprint": {"type": ["string", "null"]},
    "verificationCommands": {
      "type": "array",
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "gateCycles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "code", "system"],
      "properties": {
        "design": {"type": "integer", "minimum": 0, "maximum": 6},
        "code": {"type": "integer", "minimum": 0, "maximum": 3},
        "system": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    },
    "gateBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "code", "system"],
      "properties": {
        "design": {"const": 6},
        "code": {"const": 3},
        "system": {"const": 6}
      }
    },
    "gateBlockers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "code", "system"],
      "properties": {
        "design": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "code": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "system": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "designScrutinizeCycles": {"type": "integer", "minimum": 0, "maximum": 6},
    "systemScrutinizeCycles": {"type": "integer", "minimum": 0, "maximum": 6},
    "scrutinizeHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "system"],
      "properties": {
        "design": {"$ref": "#/$defs/scrutinizeHistory"},
        "system": {"$ref": "#/$defs/scrutinizeHistory"}
      }
    },
    "dependencies": {"type": "object", "additionalProperties": true},
    "dependencyStatus": {"type": "object", "additionalProperties": true},
    "blockedDependency": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["skills", "neededAt", "reason", "decision"],
          "properties": {
            "skills": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "owner": {"type": "string"},
                  "repository": {"type": "string"},
                  "purpose": {"type": "string"},
                  "neededAt": {"type": "string"},
                  "reason": {"type": "string"},
                  "installCommand": {"type": "string"},
                  "installScope": {"type": "string"},
                  "verifiedCommand": {"type": "boolean"}
                }
              }
            },
            "neededAt": {"type": "string"},
            "reason": {"type": "string", "minLength": 1},
            "decision": {"enum": ["PENDING", "APPROVED", "DECLINED", "VERIFIED"]}
          }
        }
      ]
    },
    "pendingInstallationPermission": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["skills", "proposals", "requestedAt", "decision"],
          "properties": {
            "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "proposals": {"type": "array", "items": {"type": "object"}},
            "requestedAt": {"type": "string", "minLength": 1},
            "decision": {"enum": ["PENDING", "APPROVED", "DECLINED"]}
          }
        }
      ]
    },
    "childWorkflowIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mitigationOutstanding": {"type": "boolean"},
    "transitionHistory": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["from", "to", "reason", "at"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "reason": {"type": "string"},
          "at": {"type": "string"}
        }
      }
    },
    "blocker": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "returnStage", "returnStageMode", "owner", "evidenceRefs"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"},
            "returnStage": {"type": "string"},
            "returnStageMode": {"enum": ["REGRESSION_TEST", "FIX", "REVIEW_FIX", "EMERGENCY_MITIGATION", "BOUND_FEATURES", "RESEARCH", "PROTOTYPE", null]},
            "owner": {"type": "string"},
            "evidenceRefs": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    },
    "updatedAt": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "scrutinizeHistory": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycleNumber",
          "verdict",
          "blockingFindings",
          "newFindings",
          "resolvedFindings",
          "repeatedFindings",
          "changedArtifacts",
          "reasonForRetry",
          "reviewRef"
        ],
        "properties": {
          "cycleNumber": {"type": "integer", "minimum": 1, "maximum": 6},
          "verdict": {"enum": ["SHIP", "FIX_THEN_SHIP", "REWORK", "REJECT"]},
          "blockingFindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "newFindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "resolvedFindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "repeatedFindings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "changedArtifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "reasonForRetry": {"type": "string"},
          "reviewRef": {"type": ["string", "null"]}
        }
      }
    }
  }
}
