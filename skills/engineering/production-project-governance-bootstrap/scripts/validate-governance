#!/usr/bin/env node

import { readFile, readdir, stat } from "node:fs/promises";
import path from "node:path";
import process from "node:process";

const IGNORE = new Set([".git", "node_modules", "vendor", "coverage", "dist", "build", "target", ".next", ".cache", ".turbo", "__pycache__"]);
const VALID_STATUS = new Set(["draft", "proposed", "accepted", "active", "deprecated", "superseded", "archived", "rejected"]);

function usage() {
  console.log("Usage: validate-governance [--root PATH] [--profile auto|repository|skill-package] [--strict] [--json]");
  console.log("       [--root-warning-bytes N] [--chain-warning-bytes N] [--max-chain-bytes N]");
}

function parseArgs(argv) {
  const options = {
    root: process.cwd(), profile: "auto", strict: false, json: false,
    rootWarningBytes: 8192, chainWarningBytes: 24576, maxChainBytes: 32768,
  };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--root") options.root = argv[++index];
    else if (arg === "--profile") options.profile = argv[++index];
    else if (arg === "--strict") options.strict = true;
    else if (arg === "--json") options.json = true;
    else if (arg === "--root-warning-bytes") options.rootWarningBytes = Number(argv[++index]);
    else if (arg === "--chain-warning-bytes") options.chainWarningBytes = Number(argv[++index]);
    else if (arg === "--max-chain-bytes") options.maxChainBytes = Number(argv[++index]);
    else if (arg === "--help" || arg === "-h") return { help: true };
    else throw new Error(`unknown argument: ${arg}`);
  }
  if (!options.root) throw new Error("--root requires a path");
  if (!["auto", "repository", "skill-package"].includes(options.profile)) throw new Error("invalid --profile");
  for (const key of ["rootWarningBytes", "chainWarningBytes", "maxChainBytes"]) {
    if (!Number.isInteger(options[key]) || options[key] < 1) throw new Error(`${key} must be a positive integer`);
  }
  if (!(options.rootWarningBytes <= options.chainWarningBytes && options.chainWarningBytes <= options.maxChainBytes)) {
    throw new Error("instruction byte thresholds must be non-decreasing");
  }
  return options;
}

async function walk(root) {
  const files = [];
  const directories = [root];
  while (directories.length > 0) {
    const directory = directories.pop();
    const entries = await readdir(directory, { withFileTypes: true });
    for (const entry of entries) {
      if (IGNORE.has(entry.name)) continue;
      const fullPath = path.join(directory, entry.name);
      if (entry.isSymbolicLink()) continue;
      if (entry.isDirectory()) directories.push(fullPath);
      else if (entry.isFile()) files.push(fullPath);
    }
  }
  return files;
}

function rel(root, file) {
  return path.relative(root, file).split(path.sep).join("/") || ".";
}

function finding(findings, severity, code, file, message) {
  findings.push({ severity, code, file, message });
}

function isInstruction(file) {
  return /(^|\/)(AGENTS|AGENTS\.override)\.md$/.test(file);
}

function normalizeRule(line) {
  return line.replace(/^\s*(?:[-*+] |\d+[.)] )/, "").toLowerCase().replace(/`/g, "").replace(/[^a-z0-9/_. -]+/g, " ").replace(/\s+/g, " ").trim();
}

function polarity(line) {
  return /\b(?:do not|don't|never|must not|cannot|forbid)\b/i.test(line) ? "negative" : "positive";
}

function ruleSubject(line) {
  return normalizeRule(line).replace(/\b(?:do not|don t|never|must not|must|always|should|cannot|required to|forbid)\b/g, "").replace(/\s+/g, " ").trim();
}

function markdownLinks(text) {
  const links = [];
  const pattern = /\[[^\]]*\]\(([^)]+)\)/g;
  let match;
  const withoutFencedCode = text.replace(/```[\s\S]*?```/g, "");
  while ((match = pattern.exec(withoutFencedCode)) !== null) links.push(match[1].trim().replace(/^<|>$/g, ""));
  return links;
}

async function exists(target) {
  try { await stat(target); return true; } catch { return false; }
}

async function nearestPackageJson(root, fromFile) {
  let directory = path.dirname(fromFile);
  while (directory.startsWith(root)) {
    const candidate = path.join(directory, "package.json");
    if (await exists(candidate)) return candidate;
    if (directory === root) break;
    directory = path.dirname(directory);
  }
  return null;
}

function commandScripts(text) {
  const scripts = [];
  const code = /`([^`\n]+)`/g;
  let match;
  while ((match = code.exec(text)) !== null) {
    const command = match[1].trim();
    let script;
    if ((match = command.match(/^npm\s+(?:run\s+)?([a-zA-Z0-9:_-]+)(?:\s|$)/))) script = match[1] === "test" ? "test" : match[1];
    else if ((match = command.match(/^pnpm\s+(?:run\s+)?([a-zA-Z0-9:_-]+)(?:\s|$)/))) script = match[1];
    else if ((match = command.match(/^yarn\s+(?:run\s+)?([a-zA-Z0-9:_-]+)(?:\s|$)/))) script = match[1];
    else if ((match = command.match(/^bun\s+run\s+([a-zA-Z0-9:_-]+)(?:\s|$)/))) script = match[1];
    if (script && !["install", "exec", "dlx"].includes(script)) scripts.push({ command, script });
  }
  return scripts;
}

async function validateSkillPackage(root, files, contents, findings) {
  const required = [
    "SKILL.md", "agents/openai.yaml", "scripts/README.md", "scripts/inspect-repository", "scripts/validate-governance",
    "evals/README.md", "evals/cases.yaml",
  ];
  const references = ["governance-model", "repository-inspection", "agents-md-design", "context-routing", "task-classification", "task-contracts", "risk-and-approvals", "engineering-memory", "automated-guardrails", "security-and-reliability", "release-and-rollback", "documentation-lifecycle", "validation-rules", "skill-evaluation"];
  const templates = ["root-AGENTS", "nested-AGENTS", "docs-index", "task-contract", "feature-spec", "implementation-plan", "PLANS", "ADR", "definition-of-ready", "definition-of-done", "risk-matrix", "engineering-lesson", "incident-report", "known-pitfalls", "test-strategy", "threat-model", "observability-contract", "release-readiness", "rollback-plan", "skill-registry", "ownership"];
  required.push(...references.map((name) => `references/${name}.md`));
  required.push(...templates.map((name) => `assets/templates/${name}.template.md`));
  const fileSet = new Set(files.map((file) => rel(root, file)));
  for (const requiredPath of required) {
    if (!fileSet.has(requiredPath)) finding(findings, "error", "required-file", requiredPath, "required skill-package file is missing");
  }
  const metadata = contents.get("agents/openai.yaml") || "";
  if (!/allow_implicit_invocation:\s*false/.test(metadata)) finding(findings, "error", "implicit-policy", "agents/openai.yaml", "explicit-only policy is missing");
  if (!/default_prompt:\s*"Use \$production-project-governance-bootstrap/.test(metadata)) finding(findings, "error", "default-prompt", "agents/openai.yaml", "default prompt must explicitly invoke the skill");
  const skillText = contents.get("SKILL.md") || "";
  if (skillText.split("\n").length > 500) finding(findings, "warning", "skill-size", "SKILL.md", "SKILL.md exceeds 500 lines");
  for (const reference of references) {
    if (!skillText.includes(`](references/${reference}.md)`)) finding(findings, "error", "reference-routing", "SKILL.md", `reference is not directly routed: ${reference}.md`);
  }
  const templateSections = {
    "root-AGENTS": ["## Scope and sources of truth", "## Safety invariants", "## Classify and route work", "## Minimum completion"],
    "nested-AGENTS": ["## Local boundaries", "## Conditional routes", "## Verified commands"],
    "docs-index": ["## Current sources of truth", "## Task routing"],
    "task-contract": ["## Problem and outcome", "## Acceptance and scope", "## Impact and controls", "## Verification and approval"],
    "feature-spec": ["## Problem, users, and outcome", "## Required behavior", "## Contracts and constraints", "## Operations"],
    "implementation-plan": ["## Current state and constraints", "## Execution sequence", "## Migration and release", "## Decision log and completion"],
    "ADR": ["## Context and constraints", "## Alternatives", "## Decision", "## Consequences and transition"],
    "engineering-lesson": ["## Failure and root cause", "## Prevention", "## Residual risk"],
    "incident-report": ["## Impact and detection", "## Root cause and contributing conditions", "## Guardrails and follow-up"],
    "threat-model": ["## Scope, assets, and actors", "## Threats and controls", "## Decisions and approval"],
    "observability-contract": ["## Correlation and privacy", "## Alert response"],
    "release-readiness": ["## Sequence and compatibility", "## Readiness checks", "## Go/no-go decision"],
    "rollback-plan": ["## Trigger and decision", "## Procedure", "## Data and dependency limits", "## Completion"],
  };
  for (const template of templates) {
    const file = `assets/templates/${template}.template.md`;
    const text = contents.get(file) || "";
    if (!(text.includes("<!-- Use") && text.includes("Do not"))) finding(findings, "error", "template-usage", file, "template must state when to use and when not to use it");
    for (const section of templateSections[template] || []) {
      if (!text.includes(section)) finding(findings, "error", "template-section", file, `missing required section: ${section}`);
    }
  }
  for (const script of ["scripts/inspect-repository", "scripts/validate-governance"]) {
    try {
      const mode = (await stat(path.join(root, script))).mode;
      if ((mode & 0o111) === 0) finding(findings, "error", "script-mode", script, "script is not executable");
    } catch { /* required-file finding already covers absence */ }
  }
  let cases;
  try { cases = JSON.parse(contents.get("evals/cases.yaml") || ""); }
  catch (error) {
    finding(findings, "error", "eval-yaml", "evals/cases.yaml", `JSON-compatible YAML cannot be parsed: ${error.message}`);
    return;
  }
  if (!Array.isArray(cases.cases) || cases.cases.length !== 10) finding(findings, "error", "eval-count", "evals/cases.yaml", "exactly ten eval cases are required");
  if (!Array.isArray(cases.rubric) || cases.rubric.length !== 10) finding(findings, "error", "eval-rubric", "evals/cases.yaml", "exactly ten rubric dimensions are required");
  for (const item of cases.cases || []) {
    if (item.fixture && ![...fileSet].some((file) => file === item.fixture || file.startsWith(`${item.fixture}/`))) {
      finding(findings, "error", "eval-fixture", "evals/cases.yaml", `missing fixture: ${item.fixture}`);
    }
    if (!Array.isArray(item.expected) || !Array.isArray(item.forbidden)) finding(findings, "error", "eval-contract", "evals/cases.yaml", `case ${item.id || "unknown"} lacks expected/forbidden arrays`);
  }
  const oversized = contents.get("evals/fixtures/oversized-agents/AGENTS.md") || "";
  if (Buffer.byteLength(oversized) <= 40960) finding(findings, "error", "oversized-fixture", "evals/fixtures/oversized-agents/AGENTS.md", "fixture must exceed 40 KiB");
}

async function main() {
  let options;
  try { options = parseArgs(process.argv.slice(2)); }
  catch (error) {
    console.error(`error: ${error.message}`);
    usage();
    process.exit(2);
  }
  if (options.help) { usage(); return; }
  const root = path.resolve(options.root);
  try { if (!(await stat(root)).isDirectory()) throw new Error("root is not a directory"); }
  catch (error) { console.error(`error: cannot validate ${root}: ${error.message}`); process.exit(2); }

  let files;
  try { files = await walk(root); }
  catch (error) { console.error(`error: inspection failed: ${error.message}`); process.exit(2); }
  const contents = new Map();
  for (const file of files) {
    if (/\.(?:md|ya?ml|json)$/i.test(file) || !path.extname(file)) {
      try { contents.set(rel(root, file), await readFile(file, "utf8")); } catch { /* reported by filesystem only when opened */ }
    }
  }
  const profile = options.profile === "auto" && contents.has("SKILL.md") && contents.has("evals/cases.yaml") ? "skill-package" : options.profile === "auto" ? "repository" : options.profile;
  const findings = [];

  for (const [file, text] of contents) {
    if (text.trim().length === 0 && (/\.md$/i.test(file) || isInstruction(file))) finding(findings, "error", "empty-document", file, "document is empty");
    if (!/\.md$/i.test(file)) continue;
    for (const link of markdownLinks(text)) {
      if (/^(?:[a-z]+:|#)/i.test(link) || link.includes("[")) continue;
      const rawPath = link.split("#")[0].split("?")[0];
      if (!rawPath) continue;
      let decoded;
      try { decoded = decodeURIComponent(rawPath); } catch { decoded = rawPath; }
      const target = path.resolve(root, path.dirname(file), decoded);
      if (!target.startsWith(root) || !(await exists(target))) finding(findings, "error", "broken-link", file, `missing relative target: ${link}`);
    }
  }

  const instructionEntries = [...contents.entries()].filter(([file]) => isInstruction(file) && !(profile === "skill-package" && file.startsWith("evals/fixtures/")));
  const byDirectory = new Map();
  for (const [file] of instructionEntries) {
    const directory = path.posix.dirname(file);
    const values = byDirectory.get(directory) || [];
    values.push(path.posix.basename(file));
    byDirectory.set(directory, values);
  }
  for (const [directory, names] of byDirectory) {
    if (names.includes("AGENTS.md") && names.includes("AGENTS.override.md")) finding(findings, "error", "dual-instructions", directory, "both AGENTS.md and AGENTS.override.md exist without machine-verifiable justification");
  }

  const rootInstruction = instructionEntries.find(([file]) => file === "AGENTS.md" || file === "AGENTS.override.md");
  if (rootInstruction && Buffer.byteLength(rootInstruction[1]) > options.rootWarningBytes) finding(findings, "warning", "root-size", rootInstruction[0], `root instruction exceeds ${options.rootWarningBytes} bytes`);
  for (const [leaf] of instructionEntries) {
    const directory = path.posix.dirname(leaf);
    const applicable = instructionEntries.filter(([candidate]) => {
      const candidateDirectory = path.posix.dirname(candidate);
      return candidateDirectory === "." || directory === candidateDirectory || directory.startsWith(`${candidateDirectory}/`);
    });
    const bytes = applicable.reduce((sum, [, text]) => sum + Buffer.byteLength(text), 0);
    if (bytes > options.maxChainBytes) finding(findings, "error", "chain-size", leaf, `active instruction chain is ${bytes} bytes, above ${options.maxChainBytes}`);
    else if (bytes > options.chainWarningBytes) finding(findings, "warning", "chain-size", leaf, `active instruction chain is ${bytes} bytes, above ${options.chainWarningBytes}`);
  }

  const rules = new Map();
  const subjects = new Map();
  for (const [file, text] of instructionEntries) {
    for (const line of text.split("\n").filter((value) => /^\s*(?:[-*+] |\d+[.)] )/.test(value) && normalizeRule(value).length >= 24)) {
      const normalized = normalizeRule(line);
      const entries = rules.get(normalized) || [];
      entries.push(file); rules.set(normalized, entries);
      const subject = ruleSubject(line);
      const subjectEntries = subjects.get(subject) || [];
      subjectEntries.push({ file, polarity: polarity(line), line: normalized }); subjects.set(subject, subjectEntries);
    }
  }
  for (const [rule, ruleFiles] of rules) {
    const unique = [...new Set(ruleFiles)];
    if (unique.length > 1) finding(findings, "warning", "duplicate-rule", unique.join(", "), `duplicate instruction candidate: ${rule}`);
  }
  for (const [, entries] of subjects) {
    if (new Set(entries.map((entry) => entry.polarity)).size > 1) finding(findings, "warning", "conflict-candidate", [...new Set(entries.map((entry) => entry.file))].join(", "), `opposing instruction polarity: ${entries.map((entry) => entry.line).join(" | ")}`);
  }

  if (profile === "repository") {
    for (const [file, text] of contents) {
      if (!/\.md$/i.test(file) || file.startsWith(".git/") || file.startsWith("evals/fixtures/")) continue;
      const lifecycle = /(^|\/)(adr|decisions|engineering-memory|incidents|lessons)(\/|\.)/i.test(file);
      if (lifecycle) {
        const statusMatch = text.match(/(?:^|\n)(?:-\s*)?Status:\s*([^\n]+)/i);
        if (!statusMatch) finding(findings, "warning", "missing-status", file, "lifecycle document has no status");
        else if (!VALID_STATUS.has(statusMatch[1].trim().toLowerCase())) finding(findings, "warning", "unknown-status", file, `unrecognized status: ${statusMatch[1].trim()}`);
        if (!/(?:^|\n)(?:-\s*)?(?:Owner|Incident owner|Operational owner):\s*\S/i.test(text)) finding(findings, "warning", "missing-owner", file, "lifecycle document has no owner");
      }
      for (const { command, script } of commandScripts(text)) {
        const packageFile = await nearestPackageJson(root, path.join(root, file));
        if (!packageFile) finding(findings, "warning", "command-source", file, `cannot verify package command without package.json: ${command}`);
        else {
          try {
            const pkg = JSON.parse(await readFile(packageFile, "utf8"));
            if (!pkg.scripts || typeof pkg.scripts[script] !== "string") finding(findings, "error", "unknown-command", file, `package script does not exist: ${command}`);
          } catch (error) { finding(findings, "error", "package-json", rel(root, packageFile), error.message); }
        }
      }
    }
    if (instructionEntries.length > 0) {
      const combined = instructionEntries.map(([, text]) => text).join("\n").toLowerCase();
      if (!(combined.includes("approval") && /destructive|production|secret/.test(combined))) finding(findings, "error", "approval-gate", instructionEntries[0][0], "always-loaded instructions do not expose a destructive/production/secret approval gate");
    }
    const memoryFiles = files.map((file) => rel(root, file)).filter((file) => /(^|\/)engineering-memory\//.test(file));
    if (memoryFiles.length > 0 && !memoryFiles.some((file) => /(^|\/)index\.md$/.test(file))) finding(findings, "warning", "memory-index", "engineering-memory", "engineering memory exists without index.md");
  } else {
    await validateSkillPackage(root, files, contents, findings);
  }

  const counts = { error: 0, warning: 0 };
  for (const item of findings) counts[item.severity] += 1;
  const failed = counts.error > 0 || (options.strict && counts.warning > 0);
  const report = { root, profile, strict: options.strict, result: failed ? "FAIL" : "PASS", counts, findings };
  if (options.json) console.log(JSON.stringify(report, null, 2));
  else {
    console.log(`${report.result}: ${root} (${profile})`);
    if (findings.length === 0) console.log("PASS no validation findings");
    for (const item of findings) console.log(`${item.severity.toUpperCase()} ${item.code} ${item.file}: ${item.message}`);
    console.log(`Summary: ${counts.error} error(s), ${counts.warning} warning(s)`);
  }
  process.exit(failed ? 1 : 0);
}

main().catch((error) => {
  console.error(`error: ${error.stack || error.message}`);
  process.exit(2);
});
